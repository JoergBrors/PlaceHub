# Copy to .env. Never commit .env. Values are non-secret identifiers/configuration.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
GITHUB_REPOSITORY=owner/PlaceHub
TF_ENVIRONMENT=development
AZURE_LOCATION=westeurope
TF_STATE_RG=rg-placehub-tfstate
TF_STATE_STORAGE=replacewithgloballyuniquename
TF_STATE_CONTAINER=tfstate
TF_STATE_KEY=placehub.development.tfstate
TF_DEPLOYMENT_APP_NAME=placehub-terraform-development

# Normal runtime is Live-First and fails closed until activation values are provided.
Microsoft365__Mode=Microsoft365ReadOnly
# Live identifiers and approval flags intentionally remain unset/false.
Microsoft365__TenantId=
Microsoft365__ClientId=
Microsoft365__CredentialProvider=Certificate
# The normal Docker profile expects a passwordless client-auth.pfx in PLACEHUB_TLS_DIRECTORY.
# Its public certificate must be separately approved and registered in Entra.
Microsoft365__AllowSyntheticData=false

# Fail-closed PlaceHub authorization. Set only after the exact Enterprise Application
# role assignment, exact signed-in user object ID and matching Microsoft Places building ID are approved.
PLACEHUB_USER_OBJECT_ID=
PLACEHUB_LOCATION_PLACE_ID=
