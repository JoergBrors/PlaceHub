# Copy to .env. Never commit .env. Values are non-secret identifiers/configuration.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
GITHUB_REPOSITORY=owner/PlaceHub
TF_ENVIRONMENT=development
AZURE_LOCATION=westeurope
TF_STATE_RG=rg-placehub-tfstate
TF_STATE_STORAGE=replacewithgloballyuniquename
TF_STATE_CONTAINER=tfstate
TF_STATE_KEY=placehub.development.tfstate
TF_DEPLOYMENT_APP_NAME=placehub-terraform-development

# PlaceHub application integration mode. OfflineMock is the only authorized default.
Microsoft365__Mode=OfflineMock
# Live identifiers and approval flags intentionally remain unset/false.
Microsoft365__TenantId=
Microsoft365__ClientId=
Microsoft365__CredentialProvider=None
Microsoft365__PermissionsApproved=false
Microsoft365__ConsentVerified=false
Microsoft365__TenantCapabilityVerified=false
Microsoft365__AllowSyntheticData=true
