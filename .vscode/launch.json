{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PlaceHub Web (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "placehub: build debug",
      "program": "${workspaceFolder}/src/PlaceHub.Web/bin/Debug/net10.0/PlaceHub.Web.dll",
      "cwd": "${workspaceFolder}/src/PlaceHub.Web",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "PlaceHub__IntegrationMode": "OfflineMock"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/schreibtischgruppen"
      }
    },
    {
      "name": "PlaceHub Web (Production assets)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "placehub: build release",
      "program": "${workspaceFolder}/src/PlaceHub.Web/bin/Release/net10.0/PlaceHub.Web.dll",
      "cwd": "${workspaceFolder}/src/PlaceHub.Web",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ASPNETCORE_URLS": "http://localhost:5001",
        "PlaceHub__IntegrationMode": "OfflineMock"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/schreibtischgruppen"
      }
    },
    {
      "name": "PlaceHub: An Prozess anfügen",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
