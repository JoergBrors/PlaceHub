FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY PlaceHub.slnx ./
COPY src/PlaceHub.Core/PlaceHub.Core.csproj src/PlaceHub.Core/
COPY src/PlaceHub.Worker/PlaceHub.Worker.csproj src/PlaceHub.Worker/
RUN dotnet restore src/PlaceHub.Worker/PlaceHub.Worker.csproj
COPY src/ src/
RUN dotnet publish src/PlaceHub.Worker/PlaceHub.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app ./
USER app
ENTRYPOINT ["dotnet", "PlaceHub.Worker.dll"]
