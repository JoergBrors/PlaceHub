@inherits LayoutComponentBase
<div class="shell">
  <input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="@(L["nav.toggle"])" />
  <aside>
    <div class="brand"><span aria-hidden="true">◆</span><strong>PlaceHub</strong><small>Workplace Management</small></div>
    <NavMenu />
    <div class="sidebar-foot"><span class="offline-dot" aria-hidden="true"></span><div><b>@ModeLabel</b><small>@ConnectionLabel</small></div></div>
  </aside>
  <main>
    <header>
      <label class="hamburger" for="nav-toggle" aria-label="@(L["nav.open"])">☰</label>
      <div class="global-search" role="search"><span aria-hidden="true">⌕</span><input aria-label="@(L["search.label"])" placeholder="@(L["search.placeholder"])" disabled title="@(L["search.disabled"])" /><kbd>Ctrl K</kbd></div>
      <div class="top-state"><span class="environment-pill"><span aria-hidden="true">▣</span> @ModeLabel</span><LanguageMenu /><RoleSwitcher /></div>
    </header>
    <section class="content">@Body</section>
  </main>
</div>
@inject Microsoft365Options Options
@inject IntegrationRuntimeState RuntimeState
@code {
 private string ModeLabel => Options.Mode == IntegrationMode.OfflineMock ? L["mode.mock"] : "Microsoft 365";
 private string ConnectionLabel => Options.Mode == IntegrationMode.OfflineMock ? L["conn.synthetic"] : RuntimeState.GraphVerified ? L["conn.verified"] : L["conn.ready"];
}
