@inherits LayoutComponentBase
<div class="shell">
  <input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="Navigation ein- oder ausblenden" />
  <aside>
    <div class="brand"><span aria-hidden="true">◆</span><strong>PlaceHub</strong><small>Workplace Management</small></div>
    <NavMenu />
    <div class="sidebar-foot"><span class="offline-dot" aria-hidden="true"></span><div><b>@ModeLabel</b><small>@ConnectionLabel</small></div></div>
  </aside>
  <main>
    <header>
      <label class="hamburger" for="nav-toggle" aria-label="Navigation öffnen">☰</label>
      <div class="global-search" role="search"><span aria-hidden="true">⌕</span><input aria-label="Globale Suche" placeholder="Suche im System …" disabled title="Globale Suche folgt nach Freigabe des Suchkonzepts" /><kbd>Ctrl K</kbd></div>
      <div class="top-state"><span class="environment-pill"><span aria-hidden="true">▣</span> @ModeLabel</span><RoleSwitcher /></div>
    </header>
    <section class="content">@Body</section>
  </main>
</div>
@inject Microsoft365Options Options
@inject IntegrationRuntimeState RuntimeState
@code {
 private string ModeLabel => Options.Mode == IntegrationMode.OfflineMock ? "Test-Mock" : "Microsoft 365";
 private string ConnectionLabel => Options.Mode == IntegrationMode.OfflineMock ? "Synthetisches Testprofil" : RuntimeState.GraphVerified ? "Graph-Zugriff verifiziert" : "Anmeldung bereit · Graph ungeprüft";
}
