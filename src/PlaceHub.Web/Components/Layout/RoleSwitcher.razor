@inject DemoActorContext ActorContext
<label class="role"><span class="avatar">@Initials</span><span class="role-copy"><b>@Name</b><small>@RoleName</small></span><select aria-label="Synthetische POC-Rolle auswählen" value="@ActorContext.Current.Role" @onchange="Change"><option value="OfficeManager">Office Manager</option><option value="LocationManager">Location Manager</option><option value="SystemAdministrator">PlaceHub Administrator</option></select></label>
@code { private string Initials=>ActorContext.Current.Role==PlaceHubRole.SystemAdministrator?"PA":ActorContext.Current.Role==PlaceHubRole.LocationManager?"LM":"OM"; private string Name=>ActorContext.Current.Role==PlaceHubRole.SystemAdministrator?"PlaceHub Admin":ActorContext.Current.Role==PlaceHubRole.LocationManager?"Location Manager":"Office Manager";private string RoleName=>"Synthetische Rolle";private void Change(ChangeEventArgs e) { ActorContext.Select(Enum.Parse<PlaceHubRole>(e.Value?.ToString() ?? "OfficeManager")); } }
