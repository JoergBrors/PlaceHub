@inject CurrentActorContext ActorContext
<div class="role"><span class="avatar">@Initials</span><span class="role-copy"><b>@Name</b><small>@RoleName</small></span><a class="ghost" href="/auth/signout">@L["role.signout"]</a></div>
@code {
 private string Initials { get { if (ActorContext.DenialCode is not null) return "–"; var parts = Name.Split(new[]{' ','.','@'}, StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : "–"; } }
 private string Name => ActorContext.Principal.Identity?.Name ?? L["role.user"];
 private string RoleName => ActorContext.DenialCode is not null ? L.F("role.noaccess", ActorContext.DenialCode) : ActorContext.IsSynthetic ? L["role.synthetic"] : ActorContext.Current.Role.ToString();
}
