@inject CurrentActorContext ActorContext
<div class="role"><span class="avatar">@Initials</span><span class="role-copy"><b>@Name</b><small>@RoleName</small></span><a class="ghost" href="/auth/signout">Abmelden</a></div>
@code {
 private string Initials => ActorContext.DenialCode is not null ? "–" : ActorContext.Current.Role==PlaceHubRole.SystemAdministrator?"PA":ActorContext.Current.Role==PlaceHubRole.LocationManager?"LM":"OM";
 private string Name => ActorContext.Principal.Identity?.Name ?? "Angemeldeter Benutzer";
 private string RoleName => ActorContext.DenialCode is not null ? $"Kein Zugriff ({ActorContext.DenialCode})" : ActorContext.IsSynthetic ? "Synthetische Testrolle" : ActorContext.Current.Role.ToString();
}
