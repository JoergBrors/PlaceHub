@page "/buchungskalender"
@rendermode InteractiveServer
@inject IPlacesReader PlacesReader
@inject IAvailabilityReader AvailabilityReader
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
<PageTitle>@L.Src("Buchungskalender") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon">▦</span><div><h1>@L.Src("Buchungskalender")</h1><p>@L["bc.sub"]</p></div></div><button @onclick="Refresh">@L["bc.read"]</button></div>
<div class="notice" role="status"><strong>@L["bc.nomut.title"]</strong>@L["bc.nomut.text"]</div>
@if(message is not null){<div class="notice" role="alert"><strong>@L["th.status"]</strong>@message</div>}
<section class="table-wrap"><table><thead><tr><th>@L["th.resource"]</th><th>@L["th.mailbox2"]</th><th>@L["th.availability"]</th><th>@L["th.source"]</th></tr></thead><tbody>@foreach(var resource in resources){<tr><td><b>@resource.DisplayName</b></td><td>@resource.EmailAddress</td><td><StatusBadge Text="@Status(resource)" /></td><td>Microsoft365ReadOnly</td></tr>}</tbody></table></section>
@code {
 private static string Code(Exception ex)=>ex switch{IntegrationException i=>i.Code,WorkflowException w=>w.Code,_=>"UNEXPECTED"};
 private string? message; private IReadOnlyList<PlaceRecord> resources=[]; private IReadOnlyDictionary<string,AvailabilityState> availability=new Dictionary<string,AvailabilityState>();
 private string Status(PlaceRecord resource)=>resource.EmailAddress is not null&&availability.TryGetValue(resource.EmailAddress,out var state)?state.ToString():"Nicht geprüft";
 protected override Task OnInitializedAsync()=>Refresh();
 private async Task Refresh(){try{var snapshot=await PlacesReader.ReadHierarchyAsync(ActorContext.CreateReadContext(Microsoft365Options),CancellationToken.None);resources=snapshot.Places.Where(x=>(x.Type==PlaceType.Workspace||x.Type==PlaceType.Room)&&!string.IsNullOrWhiteSpace(x.EmailAddress)).Take(20).ToArray();var mailboxes=resources.Select(x=>x.EmailAddress!).ToArray();if(mailboxes.Length==0){availability=new Dictionary<string,AvailabilityState>();message=L["bc.none"];return;}var start=DateTimeOffset.Now;var result=await AvailabilityReader.ReadAsync(new(ActorContext.Current.LocationIds.First(),mailboxes,start,start.AddHours(8),"W. Europe Standard Time"),ActorContext.CreateReadContext(Microsoft365Options,mailboxes),CancellationToken.None);availability=result.ToDictionary(x=>x.ResourceMailbox,x=>x.State,StringComparer.OrdinalIgnoreCase);message=L.F("bc.read.ok", result.Count);}catch(Exception ex) when (ex is IntegrationException or WorkflowException){resources=[];availability=new Dictionary<string,AvailabilityState>();message=L.Code(Code(ex));}}
}
