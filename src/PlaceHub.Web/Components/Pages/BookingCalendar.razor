@page "/buchungskalender"
@rendermode InteractiveServer
@inject IAvailabilityReader AvailabilityReader
@inject DemoActorContext ActorContext
<PageTitle>Buchungskalender · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">▦</span><div><h1>Buchungskalender</h1><p>Verfügbarkeit für Parkplätze und Schreibtischgruppen – getrennte Buchungssemantik.</p></div></div></div>
<div class="notice" role="status"><strong>Offline-Buchungssimulation</strong>„Ausstehend“, „Akzeptiert“, „Abgelehnt“ und „Unbekannt“ spiegeln den asynchronen Exchange-Prozess. Dieser Kalender ist keine Buchungsautorität.</div>
<section class="surface"><div class="calendar-toolbar"><label>Ansicht<select @bind="view"><option value="Tag">Tag</option><option value="Woche">Woche</option></select></label><label>Standort<select @bind="location"><option value="BER">Berlin Mitte</option>@if(ActorContext.Current.LocationIds.Contains("HAM")){<option value="HAM">Hamburg Hafen</option>}</select></label><label>Ressourcentyp<select @bind="resourceType"><option>Schreibtischgruppen</option><option>Parkplätze</option></select></label><label>Zeitraum<select @bind="timeRange"><option>08:00–18:00</option><option>06:00–22:00</option></select></label><button @onclick="RefreshAvailability">Verfügbarkeit lesen</button></div>@if(readMessage is not null){<p role="status" class="lead">@readMessage</p>}</section>
<section class="table-wrap" aria-label="Buchungskalender"><div class="calendar-grid">
 <div class="calendar-head">Zeit</div>@foreach(var resource in Resources){<div class="calendar-head">@resource</div>}
 @foreach(var hour in Hours){<div class="time">@hour:00</div>@foreach(var resource in Resources){var state=SlotState(resource,hour);<div><button class="calendar-slot @state.Css" disabled="@(state.Code != "AVAILABLE")" aria-label="@resource um @hour Uhr: @state.Label">@state.Label</button></div>}}
</div></section>
<section class="surface"><h2>Statuslegende</h2><div class="actions"><StatusBadge Text="Verfügbar" /><StatusBadge Text="Ausstehend" /><StatusBadge Text="Reserviert (Mock)" /><StatusBadge Text="Unbekannt" /></div><p class="lead">Konflikte werden als „Ausstehend“ oder „Unbekannt“ angezeigt, bis die externe Verarbeitung verifiziert wurde. Eine echte Reservierungsaktion bleibt bewusst deaktiviert.</p></section>
@code{
 private string view="Woche",location="BER",resourceType="Schreibtischgruppen",timeRange="08:00–18:00";private string? readMessage;private IReadOnlyDictionary<string,AvailabilityState> availability=new Dictionary<string,AvailabilityState>();private int[] Hours=>[8,10,12,14,16];private string[] Resources=>resourceType=="Parkplätze"?["P-101","P-102","P-103","P-104","P-105"]:["Fokus Nord","Projekt Süd","Hafen West","Team Mitte","Flex Ost"];private string[] Mailboxes=>resourceType=="Parkplätze"?["p-101@synthetic.invalid","p-102@synthetic.invalid","p-103@synthetic.invalid","p-104@synthetic.invalid","p-105@synthetic.invalid"]:["fokus-nord@synthetic.invalid","projekt-sued@synthetic.invalid","hafen-west@synthetic.invalid","team-mitte@synthetic.invalid","flex-ost@synthetic.invalid"];
 private (string Code,string Label,string Css) SlotState(string resource,int hour){var index=Array.IndexOf(Resources,resource);if(index>=0&&availability.TryGetValue(Mailboxes[index],out var current))return current switch{AvailabilityState.Free=>("AVAILABLE","Verfügbar",""),AvailabilityState.Busy=>("RESERVED","Belegt (Mock)","reserved"),AvailabilityState.Tentative=>("PENDING","Ausstehend","reserved"),_=>("UNKNOWN","Unbekannt","unknown")};if(resource.Contains("102")||resource.Contains("Süd"))return("RESERVED","Reserviert (Mock)","reserved");if(hour==12)return("UNKNOWN","Unbekannt","unknown");return("AVAILABLE","Verfügbar","");}
 private async Task RefreshAvailability(){try{var actor=ActorContext.Current;var request=new AvailabilityRequest(location,Mailboxes,DateTimeOffset.UtcNow.Date.AddHours(8),DateTimeOffset.UtcNow.Date.AddHours(18),"W. Europe Standard Time");var auth=new ReadAuthorizationContext("offline",actor.Id,actor.Role,actor.LocationIds,new HashSet<string>(),new HashSet<string>(Mailboxes,StringComparer.OrdinalIgnoreCase),true);var result=await AvailabilityReader.ReadAsync(request,auth,CancellationToken.None);availability=result.ToDictionary(x=>x.ResourceMailbox,x=>x.State,StringComparer.OrdinalIgnoreCase);readMessage=$"{result.Count} Ressourcen aus {result.FirstOrDefault()?.DataSource??"unbekannter Quelle"} gelesen. Keine Reservierung wurde erzeugt.";}catch(IntegrationException ex){readMessage=$"Verfügbarkeit nicht verfügbar: {ex.Code}";}catch(WorkflowException ex){readMessage=$"Ungültige Abfrage: {ex.Code}";}}
}
