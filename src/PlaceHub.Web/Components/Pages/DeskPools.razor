@page "/schreibtischgruppen"
@inject AdministrationService Service
@inject DemoActorContext ActorContext
@inject IPlacesReader PlacesReader
@rendermode InteractiveServer
<PageTitle>Schreibtischgruppen · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">♧</span><div><h1>Schreibtischgruppen</h1><p>Workspace-Ressourcen in der Hierarchie Gebäude → Etage → Bereich.</p></div></div><button @onclick="OpenForm">＋ Neue Schreibtischgruppe</button></div>
<div class="notice" role="status"><strong>Datenquelle: @dataSource</strong>@(loadError is null ? $"Letzter Lesezeitpunkt: {readAt:dd.MM.yyyy HH:mm:ss} UTC. Mailboxdiagnosen sind nur in der Detailansicht sichtbar." : $"Lesen fehlgeschlagen: {loadError}")</div>
<div class="filters"><label><span>Suche</span><input aria-label="Schreibtischgruppen durchsuchen" placeholder="Name oder Workspace …" @bind="search" @bind:event="oninput" /></label><label><span>Gebäude</span><select @bind="building"><option value="">Alle Gebäude</option>@foreach(var x in Accessible.Select(x=>x.Building).Distinct()){<option>@x</option>}</select></label><label><span>Etage</span><select @bind="floor"><option value="">Alle Etagen</option>@foreach(var x in Accessible.Select(x=>x.Floor).Distinct()){<option>@x</option>}</select></label><label><span>Bereich</span><select @bind="section"><option value="">Alle Bereiche</option>@foreach(var x in Accessible.Select(x=>x.Section).Distinct()){<option>@x</option>}</select></label><label><span>Status</span><select @bind="status"><option value="">Alle Status</option>@foreach(var x in Accessible.Select(x=>x.Status).Distinct()){<option>@x</option>}</select></label></div>
<section class="kpi-grid" aria-label="Zusammenfassung"><article class="kpi-card"><span class="kpi-icon">♧</span><div><span class="kpi-label">Gruppen</span><b class="kpi-value">@Filtered.Count()</b><small class="kpi-context">Aktuelle Filterung</small></div></article><article class="kpi-card green"><span class="kpi-icon">▱</span><div><span class="kpi-label">Arbeitsplätze</span><b class="kpi-value">@Filtered.Sum(x=>x.Capacity)</b><small class="kpi-context">Konfigurierte Kapazität</small></div></article><article class="kpi-card amber"><span class="kpi-icon">◷</span><div><span class="kpi-label">Ausstehend</span><b class="kpi-value">@Filtered.Count(x=>x.Status.Contains("Ausstehend"))</b><small class="kpi-context">Synthetischer Status</small></div></article><article class="kpi-card"><span class="kpi-icon">▱</span><div><span class="kpi-label">Aktive Workspaces</span><b class="kpi-value">@Filtered.Count(x=>x.Status=="Bereit")</b><small class="kpi-context">Extern verifiziert: nein</small></div></article></section>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Hierarchie</th><th>Kapazität</th><th>Workspace-Status</th><th>Mailbox-Metadaten</th><th>Arbeitsplätze</th><th>Aktion</th></tr></thead><tbody>
@foreach(var pool in Filtered){<tr><td><b>@pool.Name</b><small>@pool.Id</small></td><td>@pool.Building<br/><small>Etage @pool.Floor · @pool.Section</small></td><td>@pool.Capacity</td><td><StatusBadge Text="@pool.Status" /></td><td><span>Workspace (simuliert)</span><small>Technische Identität in Details</small></td><td>@pool.RelatedDesks</td><td><button class="ghost" @onclick="()=>ShowDetails(pool)">Details</button><button class="secondary" @onclick="()=>OpenCapacity(pool)">Kapazität ändern</button></td></tr>}
</tbody></table></div>
@if(selected is not null){<div class="panel"><h2>@selected.Name</h2><p><b>Native Zuordnung:</b> @selected.Building → Etage @selected.Floor → Bereich @selected.Section → Workspace @selected.Id</p><p><b>Verknüpfte Ressourcen:</b> @selected.RelatedDesks synthetische Arbeitsplätze · Mailbox <code>@selected.MailboxAlias</code></p>@if(capacityMode){<label>Neue Kapazität<input type="number" min="1" max="500" @bind="newCapacity" /></label><button @onclick="RequestCapacity">Änderungsauftrag einreichen</button>}</div>}
@if(showForm){<div class="panel"><h2>Erstellungsauftrag</h2><EditForm Model="model" OnValidSubmit="Create"><DataAnnotationsValidator /><div class="form-grid"><label>Name<input @bind="model.Name" /></label><label>Standort<select @bind="model.LocationId"><option value="BER">Berlin</option><option value="HAM">Hamburg</option></select></label><label>Gebäude<input @bind="model.Building" /></label><label>Etage<input @bind="model.Floor" /></label><label>Bereich<input @bind="model.Section" /></label><label>Kapazität<input type="number" @bind="model.Capacity" /></label><label>Mailbox-Alias<input @bind="model.MailboxAlias" /></label></div><button type="submit">Entwurf anlegen und einreichen</button><button type="button" class="secondary" @onclick="()=>showForm=false">Abbrechen</button></EditForm>@if(message is not null){<p class="notice">@message</p>}</div>}
@code {
 private string search="",building="",floor="",section="",status="",dataSource="Wird geladen"; private bool showForm,capacityMode; private string? message,loadError; private FormModel model=new(); private DeskPool? selected; private int newCapacity; private DateTimeOffset readAt; private IReadOnlyList<DeskPool> pools=[];
 private IEnumerable<DeskPool> Accessible => pools.Where(x=>ActorContext.Current.LocationIds.Contains(x.LocationId));
 private IEnumerable<DeskPool> Filtered => Accessible.Where(x=>(search.Length==0||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Id.Contains(search,StringComparison.OrdinalIgnoreCase))&&(building.Length==0||x.Building==building)&&(floor.Length==0||x.Floor==floor)&&(section.Length==0||x.Section==section)&&(status.Length==0||x.Status==status));
 private void OpenForm(){showForm=true;message=null;} private void ShowDetails(DeskPool pool){selected=pool;capacityMode=false;} private void OpenCapacity(DeskPool pool){selected=pool;newCapacity=pool.Capacity;capacityMode=true;message=null;}
 private void Create(){try{var spec=new ResourceSpecification(ResourceKind.DeskPool,OperationKind.Create,model.LocationId,model.Building,model.Floor,model.Section,model.Name,model.Capacity,model.MailboxAlias);Submit(spec);model=new();}catch(WorkflowException ex){message=$"Nicht möglich: {ex.Code}";}}
 private void RequestCapacity(){if(selected is null)return;try{var spec=new ResourceSpecification(ResourceKind.DeskPool,OperationKind.ChangeCapacity,selected.LocationId,selected.Building,selected.Floor,selected.Section,selected.Name,newCapacity,selected.MailboxAlias,"standard",1);Submit(spec);capacityMode=false;}catch(WorkflowException ex){message=$"Nicht möglich: {ex.Code}";}}
 private void Submit(ResourceSpecification spec){var request=Service.Create(spec,ActorContext.Current,Guid.NewGuid().ToString("N"));request.Submit(ActorContext.Current,request.Version);message=$"Auftrag {request.Id.ToString()[..8]} wartet auf Freigabe.";}
 protected override async Task OnInitializedAsync(){try{var actor=ActorContext.Current;var auth=new ReadAuthorizationContext("offline",actor.Id,actor.Role,actor.LocationIds,new HashSet<string>(),new HashSet<string>(),true);var snapshot=await PlacesReader.ReadHierarchyAsync(auth,CancellationToken.None);dataSource=snapshot.DataSource;readAt=snapshot.ReadAt;pools=MapWorkspaces(snapshot.Places);}catch(IntegrationException ex){loadError=ex.Code;dataSource="Nicht verfügbar";}}
 private static IReadOnlyList<DeskPool> MapWorkspaces(IReadOnlyList<PlaceRecord> places){var byId=places.ToDictionary(x=>x.Id,StringComparer.OrdinalIgnoreCase);return places.Where(x=>x.Type==PlaceType.Workspace).Select(x=>{var section=x.ParentId is not null&&byId.TryGetValue(x.ParentId,out var s)?s:null;var floor=section?.ParentId is not null&&byId.TryGetValue(section.ParentId,out var f)?f:null;var building=floor?.ParentId is not null&&byId.TryGetValue(floor.ParentId,out var b)?b:null;return new DeskPool(x.Id,building?.Id??"UNKNOWN",building?.DisplayName??"Unbekannt",floor?.DisplayName??"Unbekannt",section?.DisplayName??"Unbekannt",x.DisplayName,x.Capacity??0,x.OperationalState??"Unbekannt",x.EmailAddress??"Nicht verfügbar",x.Capacity??0);}).ToArray();}
 private sealed class FormModel { public string LocationId{get;set;}="BER"; public string Building{get;set;}="Berlin Mitte"; public string Floor{get;set;}="1"; public string Section{get;set;}="Nord"; public string Name{get;set;}=""; public int Capacity{get;set;}=8; public string MailboxAlias{get;set;}=""; }
}
