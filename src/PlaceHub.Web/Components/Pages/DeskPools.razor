@page "/schreibtischgruppen"
@inject AdministrationService Service
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@inject IPlacesReader PlacesReader
@rendermode InteractiveServer
<PageTitle>@L.Src("Schreibtischgruppen") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">♧</span><div><h1>@L.Src("Schreibtischgruppen")</h1><p>@L["dp.sub"]</p></div></div><button @onclick="OpenForm">@L["dp.new"]</button></div>
<div class="notice" role="status"><strong>@L["common.source"] @(dataSource.Length==0?L["common.loading"]:dataSource)</strong>@(loadError is null ? L.F("dp.read", readAt.ToString("dd.MM.yyyy HH:mm:ss")) : L.F("dp.readfail", loadError))</div>
<div class="filters"><label><span>@L["common.search"]</span><input aria-label="@(L["dp.search.aria"])" placeholder="@(L["dp.search.ph"])" @bind="search" @bind:event="oninput" /></label><label><span>@L["type.building"]</span><select @bind="building"><option value="">@L["dp.all.buildings"]</option>@foreach(var x in Accessible.Select(x=>x.Building).Distinct()){<option>@x</option>}</select></label><label><span>@L["type.floor"]</span><select @bind="floor"><option value="">@L["dp.all.floors"]</option>@foreach(var x in Accessible.Select(x=>x.Floor).Distinct()){<option>@x</option>}</select></label><label><span>@L["type.section"]</span><select @bind="section"><option value="">@L["dp.all.sections"]</option>@foreach(var x in Accessible.Select(x=>x.Section).Distinct()){<option>@x</option>}</select></label><label><span>@L["th.status"]</span><select @bind="status"><option value="">@L["common.allstatus"]</option>@foreach(var x in Accessible.Select(x=>x.Status).Distinct()){<option value="@x">@L.Src(x)</option>}</select></label></div>
<section class="kpi-grid" aria-label="@(L["dp.summary"])"><article class="kpi-card"><span class="kpi-icon">♧</span><div><span class="kpi-label">@L["dp.k.groups"]</span><b class="kpi-value">@Filtered.Count()</b><small class="kpi-context">@L["dp.k.groups.ctx"]</small></div></article><article class="kpi-card green"><span class="kpi-icon">▱</span><div><span class="kpi-label">@L["dp.desks"]</span><b class="kpi-value">@Filtered.Sum(x=>x.Capacity)</b><small class="kpi-context">@L["dp.k.desks.ctx"]</small></div></article><article class="kpi-card amber"><span class="kpi-icon">◷</span><div><span class="kpi-label">@L["dp.k.pending"]</span><b class="kpi-value">@Filtered.Count(x=>x.Status.Contains("Ausstehend"))</b><small class="kpi-context">@L["dp.k.pending.ctx"]</small></div></article><article class="kpi-card"><span class="kpi-icon">▱</span><div><span class="kpi-label">@L["dp.k.active"]</span><b class="kpi-value">@Filtered.Count(x=>x.Status=="Bereit")</b><small class="kpi-context">@L["dp.k.active.ctx"]</small></div></article></section>
<div class="table-wrap"><table><thead><tr><th>@L["th.name"]</th><th>@L["th.hierarchy"]</th><th>@L["th.capacity"]</th><th>@L["dp.th.wsstatus"]</th><th>@L["dp.th.meta"]</th><th>@L["dp.desks"]</th><th>@L["th.action"]</th></tr></thead><tbody>
@foreach(var pool in Filtered){<tr><td><b>@pool.Name</b><small>@pool.Id</small></td><td>@pool.Building<br/><small>@L["type.floor"] @pool.Floor · @pool.Section</small></td><td>@pool.Capacity</td><td><StatusBadge Text="@pool.Status" /></td><td><span>Microsoft Graph Workspace</span><small>@pool.MailboxAlias</small></td><td>@pool.RelatedDesks</td><td><button class="ghost" @onclick="()=>ShowDetails(pool)">@L["common.details"]</button></td></tr>}
</tbody></table></div>
@if(selected is not null){<div class="panel"><h2>@selected.Name</h2><p><b>@L["dp.native"]</b> @selected.Building → @L["type.floor"] @selected.Floor → @L["type.section"] @selected.Section → Workspace @selected.Id</p><p><b>@L["dp.graphmeta"]</b> @L["th.capacity"] @selected.Capacity · @L["th.mailbox"] <code>@selected.MailboxAlias</code></p></div>}
@if(showForm){<div class="panel"><h2>@L["dp.create.h2"]</h2><EditForm Model="model" OnValidSubmit="Create"><DataAnnotationsValidator /><div class="form-grid"><label>@L["th.name"]<input @bind="model.Name" /></label><label>@L["th.location"]<select @bind="model.LocationId"><option value="BER">Berlin</option><option value="HAM">Hamburg</option></select></label><label>@L["type.building"]<input @bind="model.Building" /></label><label>@L["type.floor"]<input @bind="model.Floor" /></label><label>@L["type.section"]<input @bind="model.Section" /></label><label>@L["th.capacity"]<input type="number" @bind="model.Capacity" /></label><label>@L["dp.alias"]<input @bind="model.MailboxAlias" /></label></div><button type="submit">@L["dp.submit"]</button><button type="button" class="secondary" @onclick="()=>showForm=false">@L["common.cancel"]</button></EditForm>@if(message is not null){<p class="notice">@message</p>}</div>}
@code {
 private string search="",building="",floor="",section="",status="",dataSource=""; private bool showForm; private string? message,loadError; private FormModel model=new(); private DeskPool? selected; private DateTimeOffset readAt; private IReadOnlyList<DeskPool> pools=[];
 private IEnumerable<DeskPool> Accessible => pools.Where(x=>ActorContext.Current.LocationIds.Contains(x.LocationId));
 private IEnumerable<DeskPool> Filtered => Accessible.Where(x=>(search.Length==0||x.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Id.Contains(search,StringComparison.OrdinalIgnoreCase))&&(building.Length==0||x.Building==building)&&(floor.Length==0||x.Floor==floor)&&(section.Length==0||x.Section==section)&&(status.Length==0||x.Status==status));
 private void OpenForm(){showForm=true;message=null;} private void ShowDetails(DeskPool pool){selected=pool;}
 private void Create(){try{var spec=new ResourceSpecification(ResourceKind.DeskPool,OperationKind.Create,model.LocationId,model.Building,model.Floor,model.Section,model.Name,model.Capacity,model.MailboxAlias);Submit(spec);model=new();}catch(WorkflowException ex){message=L.F("msg.notpossible", ex.Code);}}
 private void Submit(ResourceSpecification spec){var request=Service.Create(spec,ActorContext.Current,Guid.NewGuid().ToString("N"));request.Submit(ActorContext.Current,request.Version);message=L.F("dp.submitted", request.Id.ToString()[..8]);}
 protected override async Task OnInitializedAsync(){try{var auth=ActorContext.CreateReadContext(Microsoft365Options);var snapshot=await PlacesReader.ReadHierarchyAsync(auth,CancellationToken.None);dataSource=snapshot.DataSource;readAt=snapshot.ReadAt;pools=MapWorkspaces(snapshot.Places);}catch(IntegrationException ex){loadError=ex.Code;dataSource=L["common.unavailable"];}}
 private IReadOnlyList<DeskPool> MapWorkspaces(IReadOnlyList<PlaceRecord> places){var byId=places.ToDictionary(x=>x.Id,StringComparer.OrdinalIgnoreCase);return places.Where(x=>x.Type==PlaceType.Workspace).Select(x=>{var section=x.ParentId is not null&&byId.TryGetValue(x.ParentId,out var s)?s:null;var floor=section?.ParentId is not null&&byId.TryGetValue(section.ParentId,out var f)?f:null;var building=floor?.ParentId is not null&&byId.TryGetValue(floor.ParentId,out var b)?b:null;return new DeskPool(x.Id,building?.Id??"UNKNOWN",building?.DisplayName??L["common.unknown"],floor?.DisplayName??L["common.unknown"],section?.DisplayName??L["common.unknown"],x.DisplayName,x.Capacity??0,x.OperationalState??"Unbekannt",x.EmailAddress??L["common.unavailable"],x.Capacity??0);}).ToArray();}
 private sealed class FormModel { public string LocationId{get;set;}="BER"; public string Building{get;set;}="Berlin Mitte"; public string Floor{get;set;}="1"; public string Section{get;set;}="Nord"; public string Name{get;set;}=""; public int Capacity{get;set;}=8; public string MailboxAlias{get;set;}=""; }
}
