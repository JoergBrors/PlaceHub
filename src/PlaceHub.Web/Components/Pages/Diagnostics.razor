@page "/diagnose"
@inject IntegrationReadinessService Readiness
@inject PlacesDiagnosticsService PlacesDiagnostics
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@rendermode InteractiveServer
<PageTitle>@L.Src("Integration & Diagnose") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon">◇</span><div><h1>@L.Src("Integration & Diagnose")</h1><p>@L["dg.sub"]</p></div></div><StatusBadge Text="@ModeLabel" /></div>
<div class="notice" role="status"><strong>@L.Src(ModeLabel)</strong>@(Readiness.Mode==IntegrationMode.OfflineMock?L["dg.offline"]:L["dg.live"])</div>
<div class="table-wrap"><table><thead><tr><th>@L["dg.th.check"]</th><th>@L["th.status"]</th><th>@L["dg.th.code"]</th></tr></thead><tbody>@foreach(var item in Readiness.GetStatus()){<tr><td><b>@L.Src(item.Name)</b></td><td><StatusBadge Text="@item.State" /></td><td><code>@item.Code</code></td></tr>}</tbody></table></div>
<section class="surface"><h2>@L["dg.places.h2"]</h2><p>@L["dg.places.text"]</p>
@if(Readiness.Mode==IntegrationMode.Microsoft365ReadOnly){<button disabled="@running" @onclick="RunAsync">@(running?L["dg.running"]:L["dg.run"])</button>}else{<div class="notice" role="status">@L["dg.nosynth"]</div>}
@if(report is not null){<div class="notice" role="status"><strong>@L["dg.result"] <code>@report.Outcome</code></strong>@(L.F("dg.report", report.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss"), report.Source, report.AssignedLocations, report.AssignedLocationsResolved, report.DirectLookups))@(report.FailureCode is null?"":$" · Code: {report.FailureCode}")</div>
@if(report.Types.Count>0){<div class="table-wrap"><table><thead><tr><th>@L["th.type"]</th><th>@L["dg.th.listed"]</th><th>@L["dg.th.authorized"]</th></tr></thead><tbody>@foreach(var t in report.Types){<tr><td>@t.Type</td><td>@t.Listed</td><td>@t.Authorized</td></tr>}</tbody></table></div>}
@foreach(var w in report.Warnings){<p class="notice" role="status">@L.Src(w)</p>}}</section>
<section class="surface"><h2>@L["dg.perm.h2"]</h2><p>@L["dg.perm.text"]</p><div class="actions"><span class="feature">@L["dg.perm.place"]</span><span class="feature">@L["dg.perm.cal"]</span><span class="feature">@L["dg.perm.write"]</span></div></section>
<section class="surface"><h2>@L["dg.sec.h2"]</h2><ul><li>@L["dg.sec.1"]</li><li>@L["dg.sec.2"]</li><li>@L["dg.sec.3"]</li><li>@L["dg.sec.4"]</li></ul></section>
@code{private bool running; private PlacesDiagnosticReport? report;
 private async Task RunAsync(){running=true;try{report=await PlacesDiagnostics.RunAsync(ActorContext.CreateReadContext(Microsoft365Options),CancellationToken.None,report);}catch(IntegrationException ex){report=PlacesDiagnosticsService.Failure(ex.Code,DateTimeOffset.UtcNow);}finally{running=false;}}
 private string ModeLabel=>Readiness.Mode==IntegrationMode.OfflineMock?"Offline Mock":"Microsoft 365 Read-Only";}
