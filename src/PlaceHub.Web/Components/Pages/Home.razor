@page "/"
@inject AdministrationService Service
@inject DemoActorContext ActorContext
@rendermode InteractiveServer
<PageTitle>Dashboard · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">⌂</span><div><h1>Dashboard</h1><p>Operativer Überblick für Ihre zugewiesenen Standorte.</p></div></div><label>Standort<select @bind="location"><option value="BER">Berlin Mitte</option>@if(ActorContext.Current.LocationIds.Contains("HAM")){<option value="HAM">Hamburg Hafen</option>}</select></label></div>
<div class="notice" role="status"><strong>Synthetische Demonstrationsdaten</strong>Kennzahlen sind als Mock markiert und stellen weder Live-Belegung noch bestätigte Microsoft-365-Buchungen dar.</div>
<section class="kpi-grid" aria-label="Kennzahlen">
 <article class="kpi-card"><span class="kpi-icon" aria-hidden="true">▥</span><div class="kpi-copy"><span class="kpi-label">Gebäude</span><b class="kpi-value">1</b><small class="kpi-context">Quelle: Offline-Places-Mock · @location</small></div></article>
 <article class="kpi-card"><span class="kpi-icon" aria-hidden="true">♧</span><div class="kpi-copy"><span class="kpi-label">Schreibtischgruppen</span><b class="kpi-value">@Pools.Count()</b><small class="kpi-context">@Pools.Sum(x=>x.Capacity) Plätze konfiguriert</small></div></article>
 <article class="kpi-card green"><span class="kpi-icon" aria-hidden="true">P</span><div class="kpi-copy"><span class="kpi-label">Parkplätze verfügbar</span><b class="kpi-value">1 / 2</b><small class="kpi-context">Quelle: synthetischer Exchange-Status</small></div></article>
 <article class="kpi-card amber"><span class="kpi-icon" aria-hidden="true">◷</span><div class="kpi-copy"><span class="kpi-label">Offene Aufträge</span><b class="kpi-value">@OpenRequests</b><small class="kpi-context">Quelle: lokaler Workflow-Adapter</small></div></article>
</section>
<div class="dashboard-grid">
 <section class="surface"><h2>Kapazitätsübersicht</h2><p class="lead">Konfigurierte Kapazität – nicht gleich physische Auslastung.</p>@foreach(var pool in Pools){<div class="activity-item"><div><b>@pool.Name</b><small>@pool.Building · @pool.Floor · @pool.Section</small><div class="capacity-bar" aria-label="Kapazität @pool.Capacity von 30"><span style="width:@(Math.Min(100,pool.Capacity/30d*100))%"></span></div></div><b>@pool.Capacity Plätze</b></div>}</section>
 <section class="surface"><h2>Anstehende Vorgänge</h2><div class="activity-list">@if(!VisibleRequests.Any()){<div class="empty"><b>Keine offenen Vorgänge</b><p>Neue Ressourcenanträge erscheinen hier.</p></div>}@foreach(var request in VisibleRequests.Take(4)){<div class="activity-item"><div><b>@request.Specification.Name</b><small>@request.Specification.ResourceKind · @request.Specification.LocationId</small></div><StatusBadge Text="@RequestLabel(request.State)" /></div>}</div></section>
 <section class="surface"><h2>Bevorstehende Buchungen</h2><div class="booking-list"><div class="booking-item"><div><b>Parkplatz P-102</b><small>Heute · 09:00–18:00 · @location</small></div><StatusBadge Text="Ausstehend" /></div><div class="booking-item"><div><b>Fokus Nord</b><small>Morgen · 08:30–12:00 · Desk-Pool</small></div><StatusBadge Text="Akzeptiert (Mock)" /></div></div><a class="button secondary" href="buchungskalender">Buchungskalender öffnen</a></section>
 <section class="surface"><h2>Operative Hinweise</h2><div class="activity-list"><div class="activity-item"><div><b>Microsoft 365 nicht verbunden</b><small>Live-Status und Tenant-Berechtigungen sind nicht aktiviert.</small></div><StatusBadge Text="Offline" /></div><div class="activity-item"><div><b>Besucher erwartet</b><small>2 synthetische Besucher heute · keine personenbezogenen Echtdaten</small></div><b>2</b></div></div></section>
</div>
@code{private string location="BER";private IEnumerable<DeskPool> Pools=>SyntheticResources.DeskPools.Where(x=>x.LocationId==location&&ActorContext.Current.LocationIds.Contains(x.LocationId));private IEnumerable<AdministrationRequest> VisibleRequests=>Service.List(ActorContext.Current).Where(x=>x.Specification.LocationId==location);private int OpenRequests=>VisibleRequests.Count(x=>x.State is not (RequestState.Succeeded or RequestState.Rejected or RequestState.Failed));private static string RequestLabel(RequestState state)=>state switch{RequestState.AwaitingApproval=>"Freigabe ausstehend",RequestState.Approved=>"Freigegeben",RequestState.PartiallyConfigured=>"Teilkonfiguriert",RequestState.RequiresReconciliation=>"Abgleich erforderlich",_=>state.ToString()};}
