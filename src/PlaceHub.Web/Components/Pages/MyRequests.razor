@page "/meine-auftraege"
@inject AdministrationService Service
@inject CurrentActorContext ActorContext
@rendermode InteractiveServer
<PageTitle>@L.Src("Meine Aufträge") · PlaceHub</PageTitle>

<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">☷</span><div><h1>@L.Src("Meine Aufträge")</h1><p>@L["mr.sub"]</p></div></div><StatusBadge Text="Ausführung gesperrt" /></div>
<div class="notice" role="status"><strong>@L["mr.nolive.title"]</strong>@L["mr.nolive.text"]</div>

<section class="kpi-grid" aria-label="@(L["mr.overview"])">
 <article class="kpi-card"><div><span class="kpi-label">@L["mr.k.open"]</span><b class="kpi-value">@OpenCount</b><small class="kpi-context">@L["mr.k.open.ctx"]</small></div></article>
 <article class="kpi-card amber"><div><span class="kpi-label">@L["mr.k.approval"]</span><b class="kpi-value">@Requests.Count(x=>x.State==RequestState.AwaitingApproval)</b><small class="kpi-context">@L["mr.k.approval.ctx"]</small></div></article>
 <article class="kpi-card"><div><span class="kpi-label">@L["mr.k.worker"]</span><b class="kpi-value">@Requests.Count(x=>x.State==RequestState.Approved)</b><small class="kpi-context">@L["mr.k.worker.ctx"]</small></div></article>
 <article class="kpi-card green"><div><span class="kpi-label">@L["mr.k.done"]</span><b class="kpi-value">@Requests.Count(x=>x.State==RequestState.Succeeded)</b><small class="kpi-context">@L["mr.k.done.ctx"]</small></div></article>
</section>

<div class="filters"><label><span>@L["common.search"]</span><input aria-label="@(L["mr.search.aria"])" @bind="search" @bind:event="oninput" placeholder="@(L["mr.search.ph"])" /></label><label><span>@L["th.status"]</span><select @bind="state"><option value="">@L["common.allstatus"]</option>@foreach(var value in Enum.GetValues<RequestState>()){<option value="@value">@L.Src(Label(value))</option>}</select></label></div>
<div class="table-wrap"><table><thead><tr><th>Auftrag</th><th>@L["th.resource"]</th><th>@L["th.location"]</th><th>@L["th.status"]</th><th>@L["mr.th.changed"]</th><th>@L["mr.th.next"]</th><th>@L["common.details"]</th></tr></thead><tbody>
@foreach(var request in Filtered){var latest=request.Audit.Last();<tr><td><b>@request.Id.ToString("N")[..8]</b><small>@request.CorrelationId[..8]</small></td><td>@request.Specification.Name<small>@request.Specification.ResourceKind · @request.Specification.Operation</small></td><td>@request.Specification.LocationId</td><td><StatusBadge Text="@Label(request.State)" /></td><td>@latest.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<small>@latest.EventCode</small></td><td>@L.Src(Next(request.State))</td><td><button class="ghost" @onclick="()=>selected=request">@L["mr.timeline"]</button></td></tr>}
</tbody></table></div>
@if(!Filtered.Any()){<div class="empty"><h2>@L["mr.empty.h2"]</h2><p>@L["mr.empty.p"]</p></div>}
@if(selected is not null){<div class="panel"><h2>@L["th.order"] @selected.Id.ToString("N")[..8]</h2><p><b>@L["mr.requester"]</b> @selected.RequestedBy · <b>@L["mr.approval"]</b> @(selected.ApprovedBy ?? L["mr.notgranted"])</p><ol>@foreach(var entry in selected.Audit.OrderBy(x=>x.At)){<li><b>@entry.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</b> – @L.Src(TimelineLabel(entry.EventCode)) <code>@entry.EventCode</code></li>}</ol><p><b>@L["mr.safestatus"]</b> @selected.OutcomeCode</p><button class="secondary" @onclick="()=>selected=null">@L["common.close"]</button></div>}

@code {
 private string search="",state=""; private AdministrationRequest? selected;
 private IReadOnlyCollection<AdministrationRequest> Requests=>Service.List(ActorContext.Current);
 private IEnumerable<AdministrationRequest> Filtered=>Requests.Where(x=>(search.Length==0||x.Id.ToString("N").Contains(search,StringComparison.OrdinalIgnoreCase)||x.Specification.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||x.Specification.LocationId.Contains(search,StringComparison.OrdinalIgnoreCase))&&(state.Length==0||x.State.ToString()==state));
 private int OpenCount=>Requests.Count(x=>x.State is not (RequestState.Succeeded or RequestState.Rejected or RequestState.Failed));
 private string Label(RequestState s)=>s switch{RequestState.AwaitingApproval=>"Freigabe ausstehend",RequestState.Approved=>"Wartet auf Worker",RequestState.Running=>"In Bearbeitung",RequestState.PendingPropagation=>"Externe Verarbeitung ausstehend",RequestState.Succeeded=>"Erfolgreich",RequestState.RequiresReconciliation=>"Abgleich erforderlich",RequestState.PartiallyConfigured=>"Teilweise konfiguriert",RequestState.Failed=>"Fehlgeschlagen",RequestState.Rejected=>"Abgelehnt",_=>s.ToString()};
 private static string Next(RequestState s)=>s switch{RequestState.Draft=>"Einreichen",RequestState.AwaitingApproval=>"Administrator prüft",RequestState.Approved=>"Wartet auf Worker",RequestState.Running=>"Verifizierung abwarten",RequestState.PendingPropagation=>"Externen Zustand prüfen",RequestState.RequiresReconciliation or RequestState.PartiallyConfigured=>"Abgleich erforderlich",_=>"Kein automatischer Schritt"};
 private static string TimelineLabel(string code)=>code switch{"REQUEST_DRAFT"=>"Auftrag erstellt","REQUEST_SUBMITTED"=>"Geschäftliche Prüfung abgeschlossen","APPROVAL_REQUIRED"=>"Freigabe angefordert","REQUEST_APPROVED"=>"Versionsgebunden freigegeben","REQUEST_REJECTED"=>"Abgelehnt","MOCK_EXECUTION_STARTED"=>"Mock-Worker gestartet","MOCK_VERIFIED"=>"Ergebnis verifiziert","MOCK_PARTIAL_CONFIGURATION"=>"Teilkonfiguration erkannt","MOCK_RECONCILIATION_REQUIRED"=>"Abgleich erforderlich",_=>"Status aktualisiert"};
}
