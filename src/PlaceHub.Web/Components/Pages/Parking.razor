@page "/parkplaetze"
@inject IPlacesReader PlacesReader
@inject IAvailabilityReader AvailabilityReader
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@rendermode InteractiveServer
<PageTitle>@L.Src("Parkplätze") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon">P</span><div><h1>@L.Src("Parkplatz-Verfügbarkeit")</h1><p>@L["pk.sub"]</p></div></div><button @onclick="Refresh">@L["pk.refresh"]</button></div>
@if(error is not null){<div class="notice" role="alert"><strong>@L["pk.failed"]</strong>@error. @L["pk.nosynth"]</div>}
else if(loading){<div class="notice" role="status"><strong>@L["common.graphreading"]</strong>@L["pk.checking"]</div>}
else{<div class="notice" role="status"><strong>@L["common.source"] Microsoft365ReadOnly</strong>@L["pk.freebusy"]</div><div class="parking-grid">@foreach(var resource in resources){<article class="parking-card"><header><div><b>@resource.DisplayName</b><small>@(resource.EmailAddress??L["common.nomailbox"])</small></div><StatusBadge Text="@Status(resource)" /></header><p>@(L.F("pk.card", resource.Capacity?.ToString()??"–", readAt.ToLocalTime().ToString("HH:mm:ss")))</p></article>}</div>}
@code {
 private static string Code(Exception ex)=>ex switch{IntegrationException i=>i.Code,WorkflowException w=>w.Code,_=>"UNEXPECTED"};
 private bool loading=true; private string? error; private DateTimeOffset readAt; private IReadOnlyList<PlaceRecord> resources=[]; private IReadOnlyDictionary<string,AvailabilityState> availability=new Dictionary<string,AvailabilityState>();
 private string Status(PlaceRecord place)=>place.EmailAddress is not null&&availability.TryGetValue(place.EmailAddress,out var state)?state.ToString():"Nicht geprüft";
 protected override Task OnInitializedAsync()=>Load(); private Task Refresh()=>Load();
 private async Task Load(){loading=true;error=null;try{var auth=ActorContext.CreateReadContext(Microsoft365Options);var snapshot=await PlacesReader.ReadHierarchyAsync(auth,CancellationToken.None);resources=snapshot.Places.Where(x=>(x.Type==PlaceType.Workspace||x.Type==PlaceType.Room)&&!string.IsNullOrWhiteSpace(x.EmailAddress)).ToArray();var mailboxes=resources.Select(x=>x.EmailAddress!).ToArray();if(mailboxes.Length>0){var scoped=ActorContext.CreateReadContext(Microsoft365Options,mailboxes);var start=DateTimeOffset.Now;var request=new AvailabilityRequest(ActorContext.Current.LocationIds.First(),mailboxes.Take(20).ToArray(),start,start.AddHours(8),"W. Europe Standard Time");var result=await AvailabilityReader.ReadAsync(request,scoped,CancellationToken.None);availability=result.ToDictionary(x=>x.ResourceMailbox,x=>x.State,StringComparer.OrdinalIgnoreCase);}readAt=DateTimeOffset.UtcNow;}catch(Exception ex) when (ex is IntegrationException or WorkflowException){error=L.Code(Code(ex));resources=[];availability=new Dictionary<string,AvailabilityState>();}finally{loading=false;}}
}
