@page "/parkplaetze"
@inject AdministrationService Service
@inject DemoActorContext ActorContext
@rendermode InteractiveServer
<PageTitle>Parkplätze · PlaceHub</PageTitle><div class="page-heading"><div class="page-title"><span class="page-icon">P</span><div><h1>Parkplätze</h1><p>Ressourcen, Verfügbarkeit und genehmigungspflichtige Verwaltungsaktionen.</p></div></div><button @onclick="()=>show=true">＋ Parkplatz anfordern</button></div>
<div class="notice" role="status"><strong>Exchange bleibt Buchungsautorität.</strong>Alle Statuswerte sind synthetisch und nicht extern bestätigt.</div>
<div class="parking-grid">
 <article class="parking-card"><header><div><b>P-101 · Innenhof 1</b><small>Berlin Mitte · Zone A</small></div><StatusBadge Text="Verfügbar" /></header><div class="parking-features"><span class="feature">⚡ E-Laden</span><span class="feature">Barrierearm</span><span class="feature">Equipment-Kandidat</span></div><div class="actions"><a class="button" href="buchungskalender">Reservierung prüfen</a><button class="ghost" @onclick='()=>RequestExisting(OperationKind.ChangeBookingPolicy,"P-101")'>Buchungsregel</button><button class="danger-button" @onclick='()=>RequestExisting(OperationKind.Disable,"P-101")'>Deaktivieren</button></div></article>
 <article class="parking-card"><header><div><b>P-102 · Tiefgarage 7</b><small>Berlin Mitte · Zone B</small></div><StatusBadge Text="Reserviert (Mock)" /></header><div class="parking-features"><span class="feature">Überdacht</span><span class="feature">Equipment-Kandidat</span></div><p>Reservierungsstatus: <b>Ausstehend</b>, bis Exchange die Verarbeitung bestätigt.</p><a class="button secondary" href="buchungskalender">Details im Kalender</a></article>
 <article class="parking-card"><header><div><b>P-103 · Besucher</b><small>Berlin Mitte · Zone C</small></div><StatusBadge Text="Unbekannt" /></header><div class="parking-features"><span class="feature">Besucher</span><span class="feature">Keine Live-Prüfung</span></div><p>Verfügbarkeit konnte im Offline-Modus nicht verifiziert werden.</p></article>
</div>
@if(show){<div class="panel"><h2>Parkplatzressource anfordern</h2><div class="form-grid"><label>Name<input @bind="name" /></label><label>Mailbox-Alias<input @bind="alias" /></label></div><button @onclick="Create">Entwurf anlegen und einreichen</button></div>}
@if(message is not null){<p class="notice">@message</p>}
@code{private bool show;private string name="",alias="";private string? message;private void Create(){try{Submit(new ResourceSpecification(ResourceKind.ParkingResource,OperationKind.Create,"BER","Berlin Mitte","EG","Parken",name,1,alias));show=false;}catch(WorkflowException ex){message=ex.Code;}}private void RequestExisting(OperationKind operation,string resource){try{Submit(new ResourceSpecification(ResourceKind.ParkingResource,operation,"BER","Berlin Mitte","EG","Parken",resource,1,resource.ToLowerInvariant(),"standard",1));}catch(WorkflowException ex){message=ex.Code;}}private void Submit(ResourceSpecification spec){var r=Service.Create(spec,ActorContext.Current,Guid.NewGuid().ToString("N"));r.Submit(ActorContext.Current,r.Version);message="Parkplatzauftrag wartet auf Freigabe.";}}
