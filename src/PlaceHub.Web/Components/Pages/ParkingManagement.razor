@page "/parkplatz-verwaltung"
@inject ParkingService Parking
@inject CurrentActorContext ActorContext
@rendermode InteractiveServer
<PageTitle>@L.Src("Parkplatz-Verwaltung") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">P</span><div><h1>@L.Src("Parkplatz-Verwaltung")</h1><p>@L["pm.sub"]</p></div></div><StatusBadge Text="Provisionierung gesperrt" /></div>
<div class="notice" role="status"><strong>@L["pm.notice.title"]</strong>@L["pm.notice.text"]</div>
@if(ActorContext.DenialCode is not null){<div class="notice" role="alert"><strong>@L["pm.noaccess"]</strong>@ActorContext.DenialCode</div>}
else{
<section class="surface"><h2>@L["pm.reg.h2"]</h2>
 <EditForm Model="form" OnValidSubmit="Register"><div class="form-grid">
  <label>@L["th.location"]<select @bind="form.LocationId">@foreach(var location in ActorContext.Current.LocationIds.OrderBy(x=>x)){<option value="@location">@location</option>}</select></label>
  <label>@L["pm.f.address"]<input @bind="form.Mailbox" maxlength="254" placeholder="parkplatz01@firma.example" /></label>
  <label>@L["pm.f.display"]<input @bind="form.DisplayName" maxlength="128" /></label>
  <label>@L["th.category"]<select @bind="form.Category">@foreach(var c in Enum.GetValues<ParkingCategory>()){<option value="@c">@L.Src(CategoryLabel(c))</option>}</select></label>
  <label><input type="checkbox" @bind="form.Accessible" /> @L.Src("Barrierefrei")</label>
  <label><input type="checkbox" @bind="form.EvCharging" /> @L.Src("Ladestation")</label>
 </div><button type="submit">@L["pm.reg.submit"]</button></EditForm>
 @if(message is not null){<p class="notice" role="status">@message</p>}
</section>
<div class="table-wrap"><table><thead><tr><th>@L["pm.th.space"]</th><th>@L["th.location"]</th><th>@L["th.category"]</th><th>@L["th.features"]</th><th>@L["th.status"]</th><th>@L["th.diag"]</th><th>@L["th.action"]</th></tr></thead><tbody>
@foreach(var space in Spaces){<tr><td><b>@space.DisplayName</b><small>@space.MailboxAddress</small></td><td>@space.LocationId</td><td>@L.Src(CategoryLabel(space.Category))</td><td>@(space.Accessible?L.Src("Barrierefrei")+" ":"")@(space.EvCharging?L.Src("Ladestation"):"")</td><td><StatusBadge Text="@StatusLabel(space.Status)" /></td><td><code>@space.OutcomeCode</code></td>
 <td><button class="ghost" @onclick="()=>RequestPolicy(space,StandardTemplate)">@L["pm.policy.standard"]</button><button class="ghost" @onclick="()=>RequestPolicy(space,RestrictedTemplate)">@L["pm.policy.restricted"]</button><button class="danger-button" @onclick="()=>RequestDisable(space)">@L["pm.disable"]</button></td></tr>}
</tbody></table></div>
@if(!Spaces.Any()){<div class="empty"><h2>@L["pm.empty.h2"]</h2><p>@L["pm.empty.p"]</p></div>}
}
@code {
 private const string StandardTemplate="standard", RestrictedTemplate="restricted";
 private string? message; private readonly FormModel form=new();
 private IEnumerable<ParkingSpace> Spaces=>ActorContext.DenialCode is null?Parking.List(ActorContext.Current):[];
 protected override void OnInitialized(){if(ActorContext.DenialCode is null)form.LocationId=ActorContext.Current.LocationIds.OrderBy(x=>x).FirstOrDefault()??"";}
 private void Register(){Run(()=>{var (space,request)=Parking.RegisterExisting(ActorContext.Current,form.LocationId,form.Mailbox.Trim().ToLowerInvariant(),form.DisplayName.Trim(),form.Category,form.Accessible,form.EvCharging);return L.F("pm.m.reg", request.Id.ToString()[..8]);});}
 private void RequestPolicy(ParkingSpace space,string template){Run(()=>{var request=Parking.RequestBookingPolicy(ActorContext.Current,space.Id,template);return L.F("pm.m.policy", request.Id.ToString()[..8]);});}
 private void RequestDisable(ParkingSpace space){Run(()=>{var request=Parking.RequestDisable(ActorContext.Current,space.Id);return L.F("pm.m.disable", request.Id.ToString()[..8]);});}
 private void Run(Func<string> action){try{message=action();}catch(WorkflowException ex){message=Friendly(ex.Code);}catch(IntegrationException ex){message=Friendly(ex.Code);}}
 private string Friendly(string code){var de=FriendlyDe(code);return de is null?L.F("msg.notpossible.code",code):L.Src(de);}
 private static string? FriendlyDe(string code)=>code switch{"MAILBOX_ADDRESS_INVALID"=>"Die Postfachadresse ist ungültig.","PARKING_DISPLAY_NAME_INVALID"=>"Der Anzeigename ist ungültig.","PARKING_MAILBOX_ALREADY_REGISTERED"=>"Dieses Postfach ist bereits registriert.","LOCATION_OUT_OF_SCOPE"=>"Für diesen Standort besteht keine Berechtigung.","POLICY_TEMPLATE_NOT_ALLOWED"=>"Diese Richtlinienvorlage ist nicht erlaubt.",_=>null};
 private string CategoryLabel(ParkingCategory c)=>c switch{ParkingCategory.Standard=>"Standard",ParkingCategory.Accessible=>"Barrierefrei",ParkingCategory.ElectricVehicle=>"Elektrofahrzeug",ParkingCategory.Visitor=>"Besucher",_=>"Reserviert"};
 private string StatusLabel(ParkingStatus s)=>s switch{ParkingStatus.PendingVerification=>"Verifikation ausstehend",ParkingStatus.Provisioning=>"Wird bereitgestellt",ParkingStatus.Active=>"Verfügbar",ParkingStatus.RequiresReconciliation=>"Abgleich erforderlich",ParkingStatus.Failed=>"Fehler",_=>"Deaktivierung beantragt"};
 private sealed class FormModel{public string LocationId{get;set;}="";public string Mailbox{get;set;}="";public string DisplayName{get;set;}="";public ParkingCategory Category{get;set;}=ParkingCategory.Standard;public bool Accessible{get;set;}public bool EvCharging{get;set;}}
}
