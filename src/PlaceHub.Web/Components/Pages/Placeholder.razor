@page "/gebaeude"
@page "/etagen"
@page "/schreibtische"
@page "/reservierungen"
@page "/besucher"
@inject IPlacesReader PlacesReader
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@rendermode InteractiveServer
<div class="page-heading"><div class="page-title"><span class="page-icon">@Icon</span><div><h1>@Title</h1><p>@Description</p></div></div></div>
@if(IsPlacesPage){
 @if(error is not null){<div class="notice" role="alert"><strong>Graph-Lesen fehlgeschlagen</strong>@error. Keine synthetischen Daten werden angezeigt.</div>}
 else if(loading){<div class="notice" role="status"><strong>Microsoft Graph wird gelesen</strong></div>}
 else{<div class="notice" role="status"><strong>Datenquelle: @source</strong>@items.Count autorisierte Einträge.</div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Typ</th><th>Übergeordnet</th><th>Kapazität</th><th>Mailbox</th></tr></thead><tbody>@foreach(var item in items){<tr><td><b>@item.DisplayName</b><small>@item.Id</small></td><td>@item.Type</td><td>@(item.ParentId??"–")</td><td>@(item.Capacity?.ToString()??"–")</td><td>@(item.EmailAddress??"–")</td></tr>}</tbody></table></div>}
}else{<div class="notice" role="status"><strong>Kein freigegebener Live-Port</strong>Für diesen Bereich ist in der aktuellen read-only Aktivierung kein Microsoft-Graph-Datenvertrag freigegeben. Es werden keine Mock-Daten angezeigt.</div>}
@code {
 private string Segment=>NavigationManager.Uri.Split('/').Last(); private bool IsPlacesPage=>Segment is "gebaeude" or "etagen" or "schreibtische"; private bool loading=true; private string? error,source; private IReadOnlyList<PlaceRecord> items=[];
 private string Title=>Segment switch{"gebaeude"=>"Gebäude","etagen"=>"Etagen & Bereiche","schreibtische"=>"Schreibtische","reservierungen"=>"Reservierungen","besucher"=>"Besucher",_=>"PlaceHub"};
 private string Description=>IsPlacesPage?"Autorisierte Microsoft-Graph-Places-Daten.":"Noch nicht Bestandteil der freigegebenen read-only Schnittstellen.";
 private string Icon=>Segment switch{"gebaeude"=>"▥","etagen"=>"≡","schreibtische"=>"▱","reservierungen"=>"◷","besucher"=>"♙",_=>"◆"};
 [Inject] private NavigationManager NavigationManager{get;set;}=default!;
 protected override async Task OnInitializedAsync(){if(!IsPlacesPage){loading=false;return;}try{var snapshot=await PlacesReader.ReadHierarchyAsync(ActorContext.CreateReadContext(Microsoft365Options),CancellationToken.None);source=snapshot.DataSource;var type=Segment=="gebaeude"?PlaceType.Building:Segment=="schreibtische"?PlaceType.Desk:(PlaceType?)null;items=snapshot.Places.Where(x=>type is null?x.Type is PlaceType.Floor or PlaceType.Section:x.Type==type).ToArray();}catch(IntegrationException ex){error=ex.Code;}finally{loading=false;}}
}
