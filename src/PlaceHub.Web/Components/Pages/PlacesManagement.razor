@page "/places-verwaltung"
@inject IPlacesReader PlacesReader
@inject AdministrationService Service
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@rendermode InteractiveServer
<PageTitle>@L.Src("Places-Verwaltung") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon" aria-hidden="true">▥</span><div><h1>@L.Src("Places-Verwaltung")</h1><p>@L["pl.sub"]</p></div></div><StatusBadge Text="Schreibzugriff gesperrt" /></div>
<div class="notice" role="status"><strong>@L["pl.notice.title"]</strong>@L["pl.notice.text"]</div>
@if(error is not null){<div class="notice" role="alert"><strong>@L["common.m365unavailable"]</strong>@error. @L["common.nosynth"]</div>}
else if(loading){<div class="notice" role="status"><strong>@L["pl.reading"]</strong>@L["pl.reading.text"]</div>}
else{
 <div class="notice" role="status"><strong>@L["common.source"] @(string.IsNullOrEmpty(source)?L["common.unverified"]:source)</strong>@L.F("pl.read", readAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss"))</div>
 @if(!places.Any(x=>x.Type==PlaceType.Building)){<div class="empty"><h2>@L["pl.nobuildings.h2"]</h2><p>@L["pl.nobuildings.text"]</p></div>}
 else{
 <div class="table-wrap"><table><thead><tr><th>@L["th.type"]</th><th>@L["th.name"]</th><th>placeId</th><th>@L["th.parent"]</th><th>@L["pl.th.stamp"]</th></tr></thead><tbody>
 @foreach(var item in Ordered){<tr><td>@item.Type</td><td><b>@item.DisplayName</b></td><td><code>@Canonical(item)</code></td><td><small>@ParentName(item)</small></td><td><small>@(item.SourceUpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? L["pl.unspecified"])</small></td></tr>}
 </tbody></table></div>
 <section class="surface"><h2>@L["pl.create.h2"]</h2>
  <EditForm Model="form" OnValidSubmit="SubmitAsync"><div class="form-grid">
   <label>@L["th.operation"]<select @bind="form.Operation"><option value="@OperationKind.Create">@L["pl.op.create"]</option><option value="@OperationKind.Update">@L["pl.op.update"]</option></select></label>
   <label>@L["th.type"]<select @bind="form.Kind"><option value="@PlaceType.Floor">@L["type.floor"]</option><option value="@PlaceType.Section">@L["type.section"]</option><option value="@PlaceType.Workspace">@L["pl.t.workspace"]</option><option value="@PlaceType.Desk">@L["type.desk"]</option><option value="@PlaceType.Building">@L["pl.t.building"]</option></select></label>
   @if(form.Operation==OperationKind.Create){<label>@L["pl.parent"] (@(RequiredParentLabel))<select @bind="form.ParentPlaceId"><option value="">@L["pr.choose"]</option>@foreach(var parent in Parents){<option value="@Canonical(parent)">@parent.DisplayName</option>}</select></label>}
   else{<label>@L["pl.target"]<select @bind="form.TargetPlaceId"><option value="">@L["pr.choose"]</option>@foreach(var target in places.Where(x=>x.Type==form.Kind)){<option value="@Canonical(target)">@target.DisplayName</option>}</select></label>}
   <label>@L["pm.f.display"]<input @bind="form.DisplayName" maxlength="128" /></label>
  </div>
  @if(form.Operation==OperationKind.Create && form.Kind is PlaceType.Workspace or PlaceType.Desk){<p class="notice" role="status">@L["pl.implicit"]</p>}
  <button type="submit">@L["pl.submit"]</button></EditForm>
  @if(message is not null){<p class="notice" role="status">@message</p>}
 </section>
 }
}
<section class="surface"><h2>@L["pl.mine.h2"]</h2>
 <div class="table-wrap"><table><thead><tr><th>@L["pl.th.object"]</th><th>@L["th.operation"]</th><th>@L["th.status"]</th><th>@L["th.diag"]</th></tr></thead><tbody>
 @foreach(var request in PlacesRequests){<tr><td><b>@request.Specification.Name</b><small>@request.Specification.Places?.Kind · @request.CorrelationId[..8]</small></td><td>@request.Specification.Operation</td><td><StatusBadge Text="@Label(request.State)" /></td><td><code>@request.OutcomeCode</code></td></tr>}
 </tbody></table></div>
 @if(!PlacesRequests.Any()){<div class="empty"><h2>@L["pl.empty"]</h2></div>}
</section>
@code {
 private bool loading=true; private string? error, message, source=""; private DateTimeOffset readAt; private IReadOnlyList<PlaceRecord> places=[];
 private readonly FormModel form=new();
 private IEnumerable<AdministrationRequest> PlacesRequests=>ActorContext.DenialCode is null?Service.List(ActorContext.Current).Where(x=>x.Specification.ResourceKind==ResourceKind.PlacesHierarchy):[];
 private IEnumerable<PlaceRecord> Ordered=>places.OrderBy(x=>x.Type).ThenBy(x=>x.DisplayName,StringComparer.OrdinalIgnoreCase);
 private PlaceType? RequiredParent=>PlacesWriteSpec.RequiredParent(form.Kind);
 private string RequiredParentLabel=>RequiredParent?.ToString()??L["pl.noparent"];
 private IEnumerable<PlaceRecord> Parents=>RequiredParent is { } type?places.Where(x=>x.Type==type):[];
 private static string Canonical(PlaceRecord p)=>p.StablePlaceId??p.Id;
 private string ParentName(PlaceRecord p)=>p.ParentId is null?"–":places.FirstOrDefault(x=>x.Id==p.ParentId||x.StablePlaceId==p.ParentId)?.DisplayName??L["pl.unknown"];
 protected override async Task OnInitializedAsync(){try{var snapshot=await PlacesReader.ReadHierarchyAsync(ActorContext.CreateReadContext(Microsoft365Options),CancellationToken.None);places=snapshot.Places;source=snapshot.DataSource;readAt=snapshot.ReadAt;}catch(IntegrationException ex){error=ex.Code;}finally{loading=false;}}
 private string? LocationOf(PlaceRecord? place){while(place is not null){if(place.Type==PlaceType.Building)return Canonical(place);var parent=place.ParentId;place=parent is null?null:places.FirstOrDefault(x=>x.Id==parent||x.StablePlaceId==parent);}return null;}
 private Task SubmitAsync()
 {
  try
  {
   var anchor=form.Operation==OperationKind.Create?(RequiredParent is null?null:places.FirstOrDefault(x=>Canonical(x)==form.ParentPlaceId)):places.FirstOrDefault(x=>Canonical(x)==form.TargetPlaceId);
   var location=LocationOf(anchor)??throw new ValidationException("PLACE_LOCATION_UNRESOLVED");
   var spec=form.Operation==OperationKind.Create?new PlacesWriteSpec(form.Kind,form.DisplayName.Trim(),form.ParentPlaceId):new PlacesWriteSpec(form.Kind,form.DisplayName.Trim(),null,TargetPlaceId:form.TargetPlaceId);
   var request=Service.Create(ResourceSpecification.ForPlaces(form.Operation,location,spec),ActorContext.Current,Guid.NewGuid().ToString("N"));
   request.Submit(ActorContext.Current,request.Version);
   message=L.F("pl.m.submitted", request.Id.ToString()[..8]);
  }
  catch(WorkflowException ex){message=L.F("msg.notpossible", ex.Code);}
  catch(IntegrationException ex){message=L.F("msg.notpossible", ex.Code);}
  return Task.CompletedTask;
 }
 private string Label(RequestState s)=>s switch{RequestState.Draft=>"Entwurf",RequestState.Submitted or RequestState.AwaitingApproval=>"Freigabe ausstehend",RequestState.Approved=>"Freigegeben, nicht ausgeführt",RequestState.Rejected=>"Abgelehnt",RequestState.Running=>"In Bearbeitung",RequestState.PendingPropagation=>"Wartet auf Verbreitung",RequestState.Succeeded=>"Erfolgreich provisioniert",RequestState.PartiallyConfigured=>"Teilweise konfiguriert",RequestState.RequiresReconciliation=>"Abgleich erforderlich",RequestState.Failed=>"Fehler",_=>"Unbekannt"};
 private sealed class FormModel{public OperationKind Operation{get;set;}=OperationKind.Create;public PlaceType Kind{get;set;}=PlaceType.Floor;public string ParentPlaceId{get;set;}="";public string TargetPlaceId{get;set;}="";public string DisplayName{get;set;}="";}
}
