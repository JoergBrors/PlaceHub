@page "/provisionierung"
@page "/administration"
@page "/freigaben"
@inject AdministrationService Service
@inject CurrentActorContext ActorContext
@inject Microsoft365Options Microsoft365Options
@rendermode InteractiveServer
<PageTitle>@L.Src("Provisionierungsaufträge") · PlaceHub</PageTitle>
<div class="page-heading"><div class="page-title"><span class="page-icon">↻</span><div><h1>@L.Src("Provisionierungsaufträge")</h1><p>@L["pv.sub"]</p></div></div><StatusBadge Text="Privilegierte Ausführung gesperrt" /></div>
@if(ActorContext.Current.Role != PlaceHubRole.SystemAdministrator){<div class="notice" role="status"><strong>@L["pv.ro.title"]</strong>@L["pv.ro.text"]</div>}else{<div class="notice" role="status"><strong>@L["pv.adm.title"]</strong>@L["pv.adm.text"]</div>}
<div class="table-wrap"><table><thead><tr><th>@L["th.resource"]</th><th>@L["th.operation"]</th><th>@L["th.location"]</th><th>@L["th.status"]</th><th>@L["th.diag"]</th><th>@L["th.action"]</th></tr></thead><tbody>
@foreach(var request in Requests){<tr><td><b>@request.Specification.Name</b><small>@request.Specification.ResourceKind · @request.CorrelationId[..8]</small>@if(request.Specification.Exchange is { } exchange){<small>Exchange @exchange.MailboxAddress@(exchange.PolicyTemplateId is null?"":L["pv.policy"]+exchange.PolicyTemplateId)</small>}@if(request.Specification.Places is { } places){<small>Places @places.Kind@(places.ParentPlaceId is null?"":L["pv.parent"]+places.ParentPlaceId)@(places.TargetPlaceId is null?"":L["pv.target"]+places.TargetPlaceId)</small>}</td><td>@request.Specification.Operation</td><td>@request.Specification.LocationId</td><td><StatusBadge Text="@Label(request.State)" /></td><td><code>@request.OutcomeCode</code></td><td>
@if(request.State==RequestState.AwaitingApproval){<button disabled="@(ActorContext.Current.Role!=PlaceHubRole.SystemAdministrator)" @onclick="()=>Approve(request)">@L["pv.approve"]</button><button class="danger-button" disabled="@(ActorContext.Current.Role!=PlaceHubRole.SystemAdministrator)" @onclick="()=>Reject(request)">@L["pv.reject"]</button>}
@if(request.State==RequestState.Approved){<button disabled="@(ActorContext.Current.Role!=PlaceHubRole.SystemAdministrator || Microsoft365Options.Mode!=IntegrationMode.OfflineMock)" @onclick="()=>Execute(request)">@L["pv.exec"]</button>}
</td></tr>}
</tbody></table></div>
@if(!Requests.Any()){<div class="empty"><h2>@L["pv.empty.h2"]</h2><p>@L["pv.empty.p"]</p></div>}
@if(message is not null){<p class="notice">@message</p>}
@code {
 private string? message; private IReadOnlyCollection<AdministrationRequest> Requests=>Service.List(ActorContext.Current);
 private void Approve(AdministrationRequest r){try{r.Approve(ActorContext.Current,r.Version);message=L["pv.m.approved"];}catch(WorkflowException ex){message=ex.Code=="SELF_APPROVAL_DENIED"?L["pv.m.self"]:ex.Code;}}
 private void Reject(AdministrationRequest r){try{r.Reject(ActorContext.Current,r.Version);message=L["pv.m.rejected"];}catch(WorkflowException ex){message=ex.Code;}}
 private async Task Execute(AdministrationRequest r){try{await Service.ExecuteAsync(r.Id,ActorContext.Current,r.Version);message=L["pv.m.executed"];}catch(WorkflowException ex){message=ex.Code;}}
 private string Label(RequestState s)=>s switch{RequestState.AwaitingApproval=>"Freigabe ausstehend",RequestState.PendingPropagation=>"Wartet auf Verbreitung",RequestState.Running=>"In Bearbeitung",RequestState.Succeeded=>"Erfolgreich provisioniert",RequestState.PartiallyConfigured=>"Teilweise konfiguriert",RequestState.RequiresReconciliation=>"Abgleich erforderlich",RequestState.Failed=>"Fehlgeschlagen",_=>s.ToString()};
}
